# ------------------------------------------------------------------
# EVExpert — variables d'environnement (exemple)
# Copiez ce fichier en .env.local et renseignez les valeurs.
# Ne commitez JAMAIS .env.local. Aucune valeur secrète dans ce fichier.
# ------------------------------------------------------------------

# URL publique du site (canonical, sitemap, Open Graph). Vide = https://www.evexpert.fr
# Domaine canonique : www.evexpert.fr (evexpert.fr redirige en 308 vers www).
NEXT_PUBLIC_SITE_URL="https://www.evexpert.fr"

# --- Base de données PostgreSQL / Supabase (voir docs/supabase.md) ---
# Connexion APPLICATIVE, lecture seule (rôle evexpert_app), via le pooler
# transactionnel Supabase (port 6543). C'est la SEULE variable à définir dans Vercel.
# Absente : le site lit les données locales (src/data/vehicles.ts) — développement uniquement.
# DATABASE_URL="postgresql://evexpert_app.<project-ref>:<mot-de-passe>@<pooler-host>:6543/postgres"

# Connexion ADMIN (écriture) pour `npm run db:migrate` et `npm run db:import`.
# LOCAL UNIQUEMENT — ne jamais la définir dans Vercel.
# Utiliser la connexion directe Supabase (port 5432) ou le pooler en mode session.
# DATABASE_ADMIN_URL="postgresql://postgres:<mot-de-passe>@db.<project-ref>.supabase.co:5432/postgres"

# Taille du pool de connexions par processus (défaut 3).
# DATABASE_POOL_MAX="3"
# "disable" pour désactiver SSL (jamais nécessaire avec Supabase ; automatique en local).
# DATABASE_SSL=""
# "local" force la lecture de src/data/vehicles.ts même si DATABASE_URL est définie.
# EVEXPERT_DATA_SOURCE=""

# --- Contact et éditeur (affichés sur /contact et /mentions-legales si renseignés) ---
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_PUBLISHER_NAME=""
NEXT_PUBLIC_PUBLISHER_STATUS=""
NEXT_PUBLIC_PUBLISHER_ADDRESS=""
NEXT_PUBLIC_PUBLICATION_DIRECTOR=""

# --- Google AdSense (désactivé) ---
ADSENSE_ENABLED="false"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# --- Google Analytics 4 (optionnel, chargé uniquement après consentement) ---
# Measurement ID (ex. "G-XXXXXXXXXX"). Pas de Google Tag Manager : intégration directe.
# SANS préfixe NEXT_PUBLIC_ : lu uniquement côté serveur (app/layout.tsx, Server Component) et
# transmis en prop à Analytics.tsx. Ce n'est pas un secret (un Measurement ID GA4 doit de toute
# façon atteindre le navigateur pour fonctionner) : l'absence de préfixe évite seulement un
# avertissement Vercel sur les variables "publiques", elle ne le rend pas confidentiel.
GA_ID=""
