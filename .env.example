# ------------------------------------------------------------------
# EVExpert — variables d'environnement (exemple)
# Copiez ce fichier en .env.local et renseignez les valeurs.
# Aucune de ces variables n'est un secret ; ne commitez jamais .env.local.
# ------------------------------------------------------------------

# URL publique du site (canonical, sitemap, Open Graph). Vide = https://evexpert.fr
NEXT_PUBLIC_SITE_URL="https://evexpert.fr"

# Base de données PostgreSQL (Drizzle ORM) — OPTIONNELLE.
# Non requise : le site fonctionne sur des données statiques.
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Contact et éditeur (affichés sur /contact et /mentions-legales si renseignés) ---
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_PUBLISHER_NAME=""
NEXT_PUBLIC_PUBLISHER_STATUS=""
NEXT_PUBLIC_PUBLISHER_ADDRESS=""
NEXT_PUBLIC_PUBLICATION_DIRECTOR=""

# --- Google AdSense (désactivé) ---
ADSENSE_ENABLED="false"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# --- Analytics (optionnel, chargé uniquement après consentement) ---
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
