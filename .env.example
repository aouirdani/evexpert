# ------------------------------------------------------------------
# EVExpert — variables d'environnement (exemple)
# Copiez ce fichier en .env.local et renseignez les valeurs.
# ------------------------------------------------------------------

# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://evexpert.example"

# Base de données PostgreSQL (Drizzle ORM)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# --- Google AdSense (désactivé par défaut) ---
ADSENSE_ENABLED="false"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# --- Analytics (optionnel, chargé uniquement après consentement) ---
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
